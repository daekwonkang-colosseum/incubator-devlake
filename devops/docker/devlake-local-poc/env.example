# =====================================================================
# DevLake 환경 변수 예시
#
# 사용법:
#   cp env.example .env
#   # ENCRYPTION_SECRET 값을 채워 넣은 뒤
#   docker compose up -d
# =====================================================================

# DB 연결 (docker-compose 내부 네트워크의 mysql 서비스명 사용)
DB_URL=mysql://merico:merico@mysql:3306/lake?charset=utf8mb4&parseTime=True

# 타임존
TZ=Asia/Seoul

# =====================================================================
# 암호화 키 — 반드시 채워야 컨테이너가 정상 기동됨
# =====================================================================
# DevLake가 Jira·GitHub PAT 등 민감 정보를 DB에 저장할 때 사용.
#
# 생성 명령 (128자 대문자 문자열):
#   openssl rand -base64 2000 | tr -dc 'A-Z' | fold -w 128 | head -n 1
#
# ⚠️ 한 번 설정한 후 절대 변경 금지
#    변경 시 기존에 저장된 자격증명을 복호화할 수 없어
#    모든 Connection을 재등록해야 합니다.
# =====================================================================
ENCRYPTION_SECRET=

# =====================================================================
# 선택 설정
# =====================================================================

# Config UI 기본 인증 (운영 시 활성화 권장)
# ADMIN_USER=devlake
# ADMIN_PASS=changeme

# 파이프라인 동시 실행 수 (로컬 PoC 환경은 1 권장)
PIPELINE_MAX_PARALLEL=1
